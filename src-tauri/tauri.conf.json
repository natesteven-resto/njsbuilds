{
  "productName": "Film Room",
  "version": "0.1.0",
  "identifier": "com.njsbuilds.filmroom",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "https://www.njsbuilds.com/filmroom",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "Film Room",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "url": "https://www.njsbuilds.com/filmroom"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": ""
    },
    "publisher": "NJS Builds",
    "copyright": "© 2026 NJS Builds",
    "shortDescription": "Film Room — Video analysis for coaches",
    "longDescription": "Film Room is a native Windows app for coaches to upload, review, and analyze game film with their teams."
  }
}